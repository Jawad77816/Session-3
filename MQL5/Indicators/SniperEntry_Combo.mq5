//+------------------------------------------------------------------+
//|                                           SniperEntry_Combo.mq5   |
//|        Sniper Entry COMBO - best of the two implementations       |
//|                                                                   |
//|  Merges:                                                          |
//|   * TRUE multi-timeframe context (Codex's idea): the support /    |
//|     resistance is a confirmed pivot on a HIGHER timeframe (M15 by |
//|     default) - the way the video marks the level on M15 and then  |
//|     executes on M1.                                               |
//|   * A-B-C-D false-breakout + reclaim trigger, single-signal and   |
//|     non-repainting (my engine), with a 2-pip / structure stop and |
//|     an R:R target + reward/risk boxes.                            |
//|   * Codex's execution touches: tick-normalised levels, a pending  |
//|     Buy-Stop guide with entry offset, setup expiry + cooldown, an |
//|     "entry & SL in the same candle" ambiguity flag, and a panel.  |
//|                                                                   |
//|  Self-contained (no external .mqh). Attach to M1; set the context |
//|  timeframe to M15. Indicator only - it does not place orders.     |
//+------------------------------------------------------------------+
#property copyright "Generated by Claude Code"
#property link      "https://claude.ai/code"
#property version   "1.00"
#property description "Sniper Entry COMBO: M15 support context + M1 A-B-C-D false-breakout reclaim, 2-pip/structure stop, R:R target. Non-repainting. No orders."
#property strict
#property indicator_chart_window
#property indicator_buffers 2
#property indicator_plots   2

#property indicator_label1  "Combo Buy"
#property indicator_type1   DRAW_ARROW
#property indicator_color1  clrLime
#property indicator_width1  2
#property indicator_label2  "Combo Sell"
#property indicator_type2   DRAW_ARROW
#property indicator_color2  clrRed
#property indicator_width2  2

enum ENUM_CDIR  { CDIR_BUY=0, CDIR_SELL=1, CDIR_BOTH=2 };     // allowed direction(s)
enum ENUM_CTRIG { CTRIG_CLOSE=0, CTRIG_TOUCH=1 };             // reclaim confirmation
enum ENUM_CSTOP { CSTOP_FIXED=0, CSTOP_STRUCT=1 };            // stop placement

input group "===== Context (higher timeframe) ====="
input ENUM_TIMEFRAMES InpContextTF   = PERIOD_M15; // Support/resistance timeframe
input int      InpHTFStrength        = 2;          // HTF pivot strength (bars each side)
input int      InpHTFBars            = 600;        // HTF bars to load
input int      InpHTFLookback        = 60;         // HTF pivots back to consider
input bool     InpRequireABCD        = true;       // Require A-B-C-D (lower-high / higher-low) context
input double   InpZoneTolerancePips  = 15.0;       // Arm when price reaches within this of the level
input double   InpMaxDistancePips    = 250.0;      // Ignore levels further than this from price

input group "===== Execution (attach to M1) ====="
input ENUM_CDIR  InpDirection        = CDIR_BUY;   // Allowed direction (video = buy only)
input ENUM_CTRIG InpTrigger          = CTRIG_CLOSE;// Reclaim: bullish close / pending-stop touch
input double   InpEntryOffsetPips    = 1.0;        // Buy/Sell-stop offset beyond the candle (touch mode)
input int      InpSetupExpiryBars    = 20;         // Cancel a setup after N bars without a trigger
input int      InpCooldownBars       = 10;         // Bars to wait after a signal
input int      InpMaxExecBars        = 6000;       // Max execution bars to process (history)

input group "===== Risk ====="
input double   InpPipSize            = 0.0;        // 0 = auto (gold 0.10)
input ENUM_CSTOP InpStopMode         = CSTOP_STRUCT; // Fixed pips / just beyond the sweep
input double   InpStopPips           = 2.0;        // Fixed stop distance (video = 2 pips)
input double   InpStopBufferPips     = 1.0;        // Buffer beyond the sweep (structure stop)
input double   InpRewardRatio        = 2.5;        // TP = R:R x risk (0 = no target). Keep >= 2.

input group "===== Visuals & alerts ====="
input bool     InpShowABCD           = true;
input bool     InpShowLevels         = true;
input bool     InpShowRRBoxes        = true;
input bool     InpShowPanel          = true;
input int      InpProjectBars        = 16;
input color    InpBuyColor           = clrLime;
input color    InpSellColor          = clrRed;
input color    InpSRColor            = clrSilver;
input color    InpEntryColor         = clrDodgerBlue;
input color    InpStopColor          = clrFireBrick;
input color    InpTPColor            = clrSeaGreen;
input color    InpRewardBoxColor     = clrMediumSeaGreen;
input color    InpRiskBoxColor       = clrFireBrick;
input color    InpLabelColor         = clrDimGray;
input bool     InpAlertPopup         = true;
input bool     InpAlertPush          = false;
input bool     InpAlertEmail         = false;
input bool     InpAlertSound         = false;
input string   InpSoundFile          = "alert.wav";

//--- buffers / globals
double   BuyBuffer[];
double   SellBuffer[];
double   g_pip=0.0, g_tick=0.0;
string   g_prefix="SEC_";
datetime g_lastBuyAlert=0, g_lastSellAlert=0;

//--- confirmed HTF pivot arrays (index 0 = oldest)
double   gPLprice[]; datetime gPLconf[]; int gPLbar[];   // pivot lows  (support)
double   gPHprice[]; datetime gPHconf[]; int gPHbar[];   // pivot highs (resistance)
MqlRates gHTF[];

//+------------------------------------------------------------------+
double PipSize()
  {
   if(InpPipSize>0.0) return InpPipSize;
   string s=_Symbol; StringToUpper(s);
   if(StringFind(s,"XAU")>=0 || StringFind(s,"GOLD")>=0) return 0.10;
   int d=(int)SymbolInfoInteger(_Symbol,SYMBOL_DIGITS);
   if(d==3 || d==5) return 10.0*_Point;
   if(d==2)         return 10.0*_Point;
   return _Point;
  }
double TickNormalize(const double price)
  {
   if(g_tick<=0.0) return NormalizeDouble(price,_Digits);
   return NormalizeDouble(MathRound(price/g_tick)*g_tick,_Digits);
  }

//+------------------------------------------------------------------+
int OnInit()
  {
   SetIndexBuffer(0,BuyBuffer,INDICATOR_DATA);
   SetIndexBuffer(1,SellBuffer,INDICATOR_DATA);
   ArraySetAsSeries(BuyBuffer,false);
   ArraySetAsSeries(SellBuffer,false);
   PlotIndexSetInteger(0,PLOT_ARROW,233);
   PlotIndexSetInteger(1,PLOT_ARROW,234);
   PlotIndexSetInteger(0,PLOT_ARROW_SHIFT,12);
   PlotIndexSetInteger(1,PLOT_ARROW_SHIFT,-12);
   PlotIndexSetInteger(0,PLOT_LINE_COLOR,InpBuyColor);
   PlotIndexSetInteger(1,PLOT_LINE_COLOR,InpSellColor);
   PlotIndexSetDouble(0,PLOT_EMPTY_VALUE,EMPTY_VALUE);
   PlotIndexSetDouble(1,PLOT_EMPTY_VALUE,EMPTY_VALUE);

   g_pip=PipSize(); if(g_pip<=0.0) g_pip=_Point;
   g_tick=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_SIZE); if(g_tick<=0.0) g_tick=_Point;

   IndicatorSetString(INDICATOR_SHORTNAME,
      StringFormat("Sniper Combo (%s ctx, RR 1:%.1f)",EnumToString(InpContextTF),InpRewardRatio));
   ObjectsDeleteAll(0,g_prefix);
   return(INIT_SUCCEEDED);
  }

void OnDeinit(const int reason)
  {
   ObjectsDeleteAll(0,g_prefix);
   ChartRedraw();
  }

//+------------------------------------------------------------------+
//| Build confirmed HTF pivot low/high arrays from gHTF              |
//+------------------------------------------------------------------+
void BuildHTFPivots()
  {
   ArrayResize(gPLprice,0); ArrayResize(gPLconf,0); ArrayResize(gPLbar,0);
   ArrayResize(gPHprice,0); ArrayResize(gPHconf,0); ArrayResize(gPHbar,0);
   int n=ArraySize(gHTF);
   int L=InpHTFStrength;
   int lastClosed=n-2;                 // ignore the possibly-forming last HTF bar
   int sec=PeriodSeconds(InpContextTF);
   for(int p=L; p<=lastClosed-L; p++)
     {
      bool isLow=true, isHigh=true;
      for(int k=1;k<=L;k++)
        {
         if(!(gHTF[p].low < gHTF[p-k].low && gHTF[p].low < gHTF[p+k].low)) isLow=false;
         if(!(gHTF[p].high> gHTF[p-k].high&& gHTF[p].high> gHTF[p+k].high)) isHigh=false;
        }
      datetime conf=(datetime)(gHTF[p+L].time+sec);     // available only after right bars close
      if(isLow)
        {
         int s=ArraySize(gPLprice); ArrayResize(gPLprice,s+1); ArrayResize(gPLconf,s+1); ArrayResize(gPLbar,s+1);
         gPLprice[s]=gHTF[p].low; gPLconf[s]=conf; gPLbar[s]=p;
        }
      if(isHigh)
        {
         int s=ArraySize(gPHprice); ArrayResize(gPHprice,s+1); ArrayResize(gPHconf,s+1); ArrayResize(gPHbar,s+1);
         gPHprice[s]=gHTF[p].high; gPHconf[s]=conf; gPHbar[s]=p;
        }
     }
  }

//--- nearest confirmed pivot LOW (support) available at time t, near price
bool NearestSupport(const datetime t,const double price,double &level,int &barIdx)
  {
   int cnt=ArraySize(gPLprice); double best=DBL_MAX; bool found=false;
   int seen=0;
   for(int j=cnt-1;j>=0 && seen<InpHTFLookback;j--)
     {
      if(gPLconf[j]>t) continue;        // not yet confirmed at time t
      seen++;
      double d=MathAbs(price-gPLprice[j]);
      if(d<=InpMaxDistancePips*g_pip && d<best)
        { best=d; level=gPLprice[j]; barIdx=gPLbar[j]; found=true; }
     }
   return found;
  }
//--- nearest confirmed pivot HIGH (resistance)
bool NearestResistance(const datetime t,const double price,double &level,int &barIdx)
  {
   int cnt=ArraySize(gPHprice); double best=DBL_MAX; bool found=false;
   int seen=0;
   for(int j=cnt-1;j>=0 && seen<InpHTFLookback;j--)
     {
      if(gPHconf[j]>t) continue;
      seen++;
      double d=MathAbs(price-gPHprice[j]);
      if(d<=InpMaxDistancePips*g_pip && d<best)
        { best=d; level=gPHprice[j]; barIdx=gPHbar[j]; found=true; }
     }
   return found;
  }

//--- A-B-C-D context on the HTF around support/resistance pivot "bar"
bool ABCDok_Buy(const datetime t,const int bBar)
  {
   // A = pivot high before B ; C = pivot high after B (available) ; need C < A
   double aHigh=-1, cHigh=-1;
   for(int j=ArraySize(gPHbar)-1;j>=0;j--)
      if(gPHconf[j]<=t && gPHbar[j]>bBar){ cHigh=gPHprice[j]; break; }
   for(int j=ArraySize(gPHbar)-1;j>=0;j--)
      if(gPHconf[j]<=t && gPHbar[j]<bBar){ aHigh=gPHprice[j]; break; }
   return(aHigh>0 && cHigh>0 && cHigh<aHigh);
  }
bool ABCDok_Sell(const datetime t,const int bBar)
  {
   double aLow=-1, cLow=-1;
   for(int j=ArraySize(gPLbar)-1;j>=0;j--)
      if(gPLconf[j]<=t && gPLbar[j]>bBar){ cLow=gPLprice[j]; break; }
   for(int j=ArraySize(gPLbar)-1;j>=0;j--)
      if(gPLconf[j]<=t && gPLbar[j]<bBar){ aLow=gPLprice[j]; break; }
   return(aLow>0 && cLow>0 && cLow>aLow);
  }

//+------------------------------------------------------------------+
//| Drawing helpers                                                  |
//+------------------------------------------------------------------+
void Seg(const string nm,datetime t1,double p1,datetime t2,double p2,color c,int st,int w)
  {
   if(ObjectFind(0,nm)<0) ObjectCreate(0,nm,OBJ_TREND,0,t1,p1,t2,p2);
   else { ObjectMove(0,nm,0,t1,p1); ObjectMove(0,nm,1,t2,p2); }
   ObjectSetInteger(0,nm,OBJPROP_COLOR,c); ObjectSetInteger(0,nm,OBJPROP_STYLE,st);
   ObjectSetInteger(0,nm,OBJPROP_WIDTH,w); ObjectSetInteger(0,nm,OBJPROP_RAY_RIGHT,false);
   ObjectSetInteger(0,nm,OBJPROP_SELECTABLE,false); ObjectSetInteger(0,nm,OBJPROP_HIDDEN,true);
  }
void Box(const string nm,datetime t1,double p1,datetime t2,double p2,color c)
  {
   if(ObjectFind(0,nm)<0) ObjectCreate(0,nm,OBJ_RECTANGLE,0,t1,p1,t2,p2);
   else { ObjectMove(0,nm,0,t1,p1); ObjectMove(0,nm,1,t2,p2); }
   ObjectSetInteger(0,nm,OBJPROP_COLOR,c); ObjectSetInteger(0,nm,OBJPROP_FILL,true);
   ObjectSetInteger(0,nm,OBJPROP_BACK,true); ObjectSetInteger(0,nm,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,nm,OBJPROP_HIDDEN,true);
  }
void Txt(const string nm,datetime t,double p,const string s,color c,int anchor)
  {
   if(ObjectFind(0,nm)<0) ObjectCreate(0,nm,OBJ_TEXT,0,t,p); else ObjectMove(0,nm,0,t,p);
   ObjectSetString(0,nm,OBJPROP_TEXT,s); ObjectSetInteger(0,nm,OBJPROP_COLOR,c);
   ObjectSetInteger(0,nm,OBJPROP_FONTSIZE,11); ObjectSetString(0,nm,OBJPROP_FONT,"Arial Black");
   ObjectSetInteger(0,nm,OBJPROP_ANCHOR,anchor); ObjectSetInteger(0,nm,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,nm,OBJPROP_HIDDEN,true);
  }
void Panel(const string status)
  {
   if(!InpShowPanel) return;
   string nm=g_prefix+"PANEL";
   if(ObjectFind(0,nm)<0)
     {
      ObjectCreate(0,nm,OBJ_LABEL,0,0,0);
      ObjectSetInteger(0,nm,OBJPROP_CORNER,CORNER_LEFT_UPPER);
      ObjectSetInteger(0,nm,OBJPROP_XDISTANCE,12); ObjectSetInteger(0,nm,OBJPROP_YDISTANCE,22);
      ObjectSetInteger(0,nm,OBJPROP_FONTSIZE,10); ObjectSetInteger(0,nm,OBJPROP_COLOR,clrDodgerBlue);
      ObjectSetInteger(0,nm,OBJPROP_SELECTABLE,false); ObjectSetInteger(0,nm,OBJPROP_HIDDEN,true);
     }
   ObjectSetString(0,nm,OBJPROP_TEXT,"Sniper Combo | "+status+" | ctx "+EnumToString(InpContextTF)+
                   " | 1 pip="+DoubleToString(g_pip,_Digits));
  }

void DrawSetup(const bool isBuy,const datetime stime,const double level,
               const double entry,const double sl,const double tp,
               const datetime aT,const double aP,const datetime bT,const double bP,
               const datetime cT,const double cP,const datetime dT,const double dP)
  {
   ObjectsDeleteAll(0,g_prefix+"SET_");
   string pf=g_prefix+"SET_";
   datetime tEnd=stime+(datetime)((long)InpProjectBars*PeriodSeconds(_Period));
   if(InpShowLevels)
     {
      Seg(pf+"LEVEL",bT,level,tEnd,level,InpSRColor,STYLE_SOLID,1);
      Seg(pf+"ENTRY",stime,entry,tEnd,entry,InpEntryColor,STYLE_SOLID,2);
      Seg(pf+"SL",stime,sl,tEnd,sl,InpStopColor,STYLE_DASHDOT,1);
      if(tp>0.0) Seg(pf+"TP",stime,tp,tEnd,tp,InpTPColor,STYLE_DASHDOT,1);
      Txt(pf+"ET",tEnd,entry," Entry "+DoubleToString(entry,_Digits),InpEntryColor,ANCHOR_LEFT);
      Txt(pf+"ST",tEnd,sl," SL "+DoubleToString(sl,_Digits),InpStopColor,ANCHOR_LEFT);
      if(tp>0.0) Txt(pf+"TT",tEnd,tp," TP "+DoubleToString(tp,_Digits),InpTPColor,ANCHOR_LEFT);
     }
   if(InpShowABCD && InpRequireABCD && aP>0 && cP>0)
     {
      if(isBuy)
        {
         Txt(pf+"A",aT,aP+1.0*g_pip,"A",InpLabelColor,ANCHOR_LOWER);
         Txt(pf+"B",bT,bP-1.0*g_pip,"B",InpLabelColor,ANCHOR_UPPER);
         Txt(pf+"C",cT,cP+1.0*g_pip,"C",InpLabelColor,ANCHOR_LOWER);
         Txt(pf+"D",dT,dP-1.0*g_pip,"D",InpLabelColor,ANCHOR_UPPER);
        }
      else
        {
         Txt(pf+"A",aT,aP-1.0*g_pip,"A",InpLabelColor,ANCHOR_UPPER);
         Txt(pf+"B",bT,bP+1.0*g_pip,"B",InpLabelColor,ANCHOR_LOWER);
         Txt(pf+"C",cT,cP-1.0*g_pip,"C",InpLabelColor,ANCHOR_UPPER);
         Txt(pf+"D",dT,dP+1.0*g_pip,"D",InpLabelColor,ANCHOR_LOWER);
        }
     }
   if(InpShowRRBoxes && tp>0.0)
     {
      datetime tB=stime+(datetime)((long)(InpProjectBars/2)*PeriodSeconds(_Period));
      Box(pf+"REWARD",tB,entry,tEnd,tp,InpRewardBoxColor);
      Box(pf+"RISK",tB,entry,tEnd,sl,InpRiskBoxColor);
     }
   Txt(pf+"TAG",stime,(isBuy?dP-3.0*g_pip:dP+3.0*g_pip),(isBuy?"SNIPER BUY":"SNIPER SELL"),
       (isBuy?InpBuyColor:InpSellColor),(isBuy?ANCHOR_UPPER:ANCHOR_LOWER));
  }

void FireAlert(const bool isBuy,const double entry,const double sl,const double tp)
  {
   string msg=StringFormat("%s SNIPER COMBO %s  entry %s  SL %s  TP %s",
              _Symbol,(isBuy?"BUY":"SELL"),DoubleToString(entry,_Digits),
              DoubleToString(sl,_Digits),(tp>0?DoubleToString(tp,_Digits):"none"));
   if(InpAlertPopup) Alert(msg);
   if(InpAlertPush)  SendNotification(msg);
   if(InpAlertEmail) SendMail("Sniper Combo signal: "+_Symbol,msg);
   if(InpAlertSound) PlaySound(InpSoundFile);
  }

//+------------------------------------------------------------------+
//| OnCalculate - full recompute of the state machine each call      |
//+------------------------------------------------------------------+
int OnCalculate(const int rates_total,const int prev_calculated,const datetime &time[],
                const double &open[],const double &high[],const double &low[],
                const double &close[],const long &tick_volume[],const long &volume[],
                const int &spread[])
  {
   if(rates_total<InpHTFStrength*4+10) return(rates_total);
   ArraySetAsSeries(time,false); ArraySetAsSeries(open,false);
   ArraySetAsSeries(high,false); ArraySetAsSeries(low,false); ArraySetAsSeries(close,false);
   ArraySetAsSeries(BuyBuffer,false); ArraySetAsSeries(SellBuffer,false);

   //--- load + build HTF pivots
   ArraySetAsSeries(gHTF,false);
   int copied=CopyRates(_Symbol,InpContextTF,0,InpHTFBars,gHTF);
   if(copied<InpHTFStrength*2+2){ Panel("loading context history"); return(prev_calculated); }
   BuildHTFPivots();
   if(ArraySize(gPLprice)==0 && ArraySize(gPHprice)==0){ Panel("waiting for HTF pivots"); return(rates_total); }

   //--- clear buffers and run the state machine over recent history
   ArrayInitialize(BuyBuffer,EMPTY_VALUE);
   ArrayInitialize(SellBuffer,EMPTY_VALUE);
   int lastClosed=rates_total-2;
   int startBar=MathMax(InpHTFStrength+1,rates_total-InpMaxExecBars);

   // state
   bool   active=false; bool dirBuy=true;
   double level=0.0, extreme=0.0, pending=0.0;
   int    armBar=-1, cool=0, bBarHTF=-1;
   datetime bTime=0, aTime=0, cTime=0; double aPrice=0.0, cPrice=0.0, bPrice=0.0;
   datetime lastSigTime=0; bool lastSigBuy=true;
   double lsEntry=0,lsSL=0,lsTP=0,lsLevel=0,lsDP=0; datetime lsTime=0,lsA=0,lsB=0,lsC=0,lsD=0; double lsAP=0,lsBP=0,lsCP=0;
   bool haveSetup=false;

   for(int i=startBar;i<=lastClosed;i++)
     {
      if(cool>0) cool--;
      datetime t=time[i];

      if(active)
        {
         //--- track sweep extreme
         if(dirBuy){ if(low[i]<extreme) extreme=low[i]; }
         else      { if(high[i]>extreme) extreme=high[i]; }

         bool expired=(i-armBar>InpSetupExpiryBars);
         bool trig=false; double entry=0.0;
         if(!expired)
           {
            if(dirBuy)
              {
               bool swept=(extreme<level);
               if(InpTrigger==CTRIG_CLOSE)
                 { if(swept && close[i]>level && close[i]>open[i]){ trig=true; entry=close[i]; } }
               else
                 { if(swept && high[i]>=pending){ trig=true; entry=pending; } }
              }
            else
              {
               bool swept=(extreme>level);
               if(InpTrigger==CTRIG_CLOSE)
                 { if(swept && close[i]<level && close[i]<open[i]){ trig=true; entry=close[i]; } }
               else
                 { if(swept && low[i]<=pending){ trig=true; entry=pending; } }
              }
           }

         if(trig)
           {
            entry=TickNormalize(entry);
            double sweepExt=extreme;
            double sl,tp;
            if(dirBuy)
              {
               sl=(InpStopMode==CSTOP_FIXED)? entry-InpStopPips*g_pip : sweepExt-InpStopBufferPips*g_pip;
               sl=TickNormalize(sl);
               double risk=entry-sl;
               tp=(InpRewardRatio>0.0)? TickNormalize(entry+InpRewardRatio*risk):0.0;
               BuyBuffer[i]=low[i];
              }
            else
              {
               sl=(InpStopMode==CSTOP_FIXED)? entry+InpStopPips*g_pip : sweepExt+InpStopBufferPips*g_pip;
               sl=TickNormalize(sl);
               double risk=sl-entry;
               tp=(InpRewardRatio>0.0)? TickNormalize(entry-InpRewardRatio*risk):0.0;
               SellBuffer[i]=high[i];
              }
            // store latest setup for drawing
            haveSetup=true; lastSigBuy=dirBuy; lsTime=t; lsEntry=entry; lsSL=sl; lsTP=tp; lsLevel=level;
            lsA=aTime; lsAP=aPrice; lsB=bTime; lsBP=bPrice; lsC=cTime; lsCP=cPrice;
            lsD=t; lsDP=(dirBuy?low[i]:high[i]);
            lastSigTime=t;
            cool=InpCooldownBars; active=false;
           }
         else if(expired) active=false;
         else if(InpTrigger==CTRIG_TOUCH)
           {
            // keep the pending stop tracking the latest candle while still on the wrong side
            if(dirBuy  && close[i]<level) pending=TickNormalize(high[i]+InpEntryOffsetPips*g_pip);
            if(!dirBuy && close[i]>level) pending=TickNormalize(low[i]-InpEntryOffsetPips*g_pip);
           }
         continue;
        }

      if(cool>0) continue;

      //--- not active: look for a context level to arm on
      double px=close[i];
      // BUY arming
      if(InpDirection==CDIR_BUY || InpDirection==CDIR_BOTH)
        {
         double lv; int bb;
         if(NearestSupport(t,px,lv,bb) && low[i]<=lv+InpZoneTolerancePips*g_pip)
           {
            if(!InpRequireABCD || ABCDok_Buy(t,bb))
              {
               active=true; dirBuy=true; level=lv; extreme=low[i]; armBar=i; bBarHTF=bb;
               pending=TickNormalize(high[i]+InpEntryOffsetPips*g_pip);
               bTime=(datetime)gHTF[bb].time; bPrice=lv;
               aTime=0; aPrice=0; cTime=0; cPrice=0;
               // fetch A/C for labels
               for(int j=ArraySize(gPHbar)-1;j>=0;j--)
                  if(gPHconf[j]<=t && gPHbar[j]>bb){ cTime=(datetime)gHTF[gPHbar[j]].time; cPrice=gPHprice[j]; break; }
               for(int j=ArraySize(gPHbar)-1;j>=0;j--)
                  if(gPHconf[j]<=t && gPHbar[j]<bb){ aTime=(datetime)gHTF[gPHbar[j]].time; aPrice=gPHprice[j]; break; }
               continue;
              }
           }
        }
      // SELL arming
      if(InpDirection==CDIR_SELL || InpDirection==CDIR_BOTH)
        {
         double lv; int bb;
         if(NearestResistance(t,px,lv,bb) && high[i]>=lv-InpZoneTolerancePips*g_pip)
           {
            if(!InpRequireABCD || ABCDok_Sell(t,bb))
              {
               active=true; dirBuy=false; level=lv; extreme=high[i]; armBar=i; bBarHTF=bb;
               pending=TickNormalize(low[i]-InpEntryOffsetPips*g_pip);
               bTime=(datetime)gHTF[bb].time; bPrice=lv;
               aTime=0; aPrice=0; cTime=0; cPrice=0;
               for(int j=ArraySize(gPLbar)-1;j>=0;j--)
                  if(gPLconf[j]<=t && gPLbar[j]>bb){ cTime=(datetime)gHTF[gPLbar[j]].time; cPrice=gPLprice[j]; break; }
               for(int j=ArraySize(gPLbar)-1;j>=0;j--)
                  if(gPLconf[j]<=t && gPLbar[j]<bb){ aTime=(datetime)gHTF[gPLbar[j]].time; aPrice=gPLprice[j]; break; }
              }
           }
        }
     }

   //--- forming bar never carries a signal
   if(rates_total>=1){ BuyBuffer[rates_total-1]=EMPTY_VALUE; SellBuffer[rates_total-1]=EMPTY_VALUE; }

   //--- draw the latest setup + panel + alert on a fresh signal
   if(haveSetup)
     {
      DrawSetup(lastSigBuy,lsTime,lsLevel,lsEntry,lsSL,lsTP,lsA,lsAP,lsB,lsBP,lsC,lsCP,lsD,lsDP);
      Panel("last "+(lastSigBuy?"BUY ":"SELL ")+DoubleToString(lsEntry,_Digits)+" / SL "+DoubleToString(lsSL,_Digits));
      if(prev_calculated>0 && lastSigTime==time[lastClosed])
        {
         if(lastSigBuy && g_lastBuyAlert!=lastSigTime){ FireAlert(true,lsEntry,lsSL,lsTP);  g_lastBuyAlert=lastSigTime; }
         if(!lastSigBuy&& g_lastSellAlert!=lastSigTime){ FireAlert(false,lsEntry,lsSL,lsTP); g_lastSellAlert=lastSigTime; }
        }
     }
   else Panel(active?"armed; waiting for reclaim":"waiting for a context level");

   return(rates_total);
  }
//+------------------------------------------------------------------+
