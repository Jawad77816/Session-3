//+------------------------------------------------------------------+
//|                                   SniperEntry_FalseBreakout.mq5   |
//|                  Sniper Entry - 1-Minute Scalping / 2-Pip Stop    |
//|                                                                  |
//|  Re-creates the "Sniper Entry" false-breakout reversal strategy   |
//|  shown in the reference video (XAUUSD):                           |
//|                                                                  |
//|     A  = swing HIGH                                               |
//|     B  = pullback LOW  -> becomes the SUPPORT level               |
//|     C  = LOWER high  (price can't reclaim A)                      |
//|     D  = LOWER low  -> price sweeps BELOW support = FALSE BREAKOUT |
//|          then price RECLAIMS support -> BUY ("sniper entry")      |
//|                                                                  |
//|  Entry : reclaim of the swept level (the video places a Buy Stop) |
//|  Stop  : a very tight, fixed distance (video = 2 pips) that sits  |
//|          just under the sweep low  -> "MINIMAL RISK"              |
//|  Target: ride the reversal for a large reward-to-risk ratio       |
//|                                                                  |
//|  The SELL case is the exact mirror (sweep ABOVE resistance).      |
//|                                                                  |
//|  This is an INDICATOR: it detects, draws and alerts. It does not  |
//|  send orders. Signals are evaluated on CLOSED bars (no repaint).  |
//+------------------------------------------------------------------+
#property copyright "Generated by Claude Code"
#property link      "https://claude.ai/code"
#property version   "1.00"
#property description "Sniper Entry - false-breakout (liquidity sweep) reversal with A-B-C-D structure, 2-pip stop and R:R projection. Built from the reference video."
#property strict

#property indicator_chart_window
#property indicator_buffers 2
#property indicator_plots   2

//--- Plot 0 : Buy signal arrow
#property indicator_label1  "Sniper Buy"
#property indicator_type1   DRAW_ARROW
#property indicator_color1  clrLime
#property indicator_width1  2
//--- Plot 1 : Sell signal arrow
#property indicator_label2  "Sniper Sell"
#property indicator_type2   DRAW_ARROW
#property indicator_color2  clrRed
#property indicator_width2  2

//+------------------------------------------------------------------+
//| Inputs                                                           |
//+------------------------------------------------------------------+
enum ENUM_DIRN
  {
   DIR_BOTH = 0,  // Buy & Sell
   DIR_BUY  = 1,  // Buy only  (false breakdown of support)
   DIR_SELL = 2   // Sell only (false breakout of resistance)
  };

input group             "===== Structure detection (A-B-C-D) ====="
input int      InpSwingLength      = 5;      // Swing strength (bars on each side of a pivot)
input int      InpLookbackPivots   = 150;    // Max bars back to search for the structure
input bool     InpRequireABCD      = true;   // Require A-B-C-D (lower-high/higher-low context)
input int      InpReclaimBars      = 3;      // Max bars from the sweep extreme to the reclaim close
input bool     InpRequireSweepClose= false;  // Require the sweep bar to CLOSE beyond the level too

input group             "===== Risk model (from the video) ====="
input ENUM_DIRN InpDirection       = DIR_BOTH; // Allowed signal direction
input double   InpStopPips         = 2.0;    // Stop-loss distance in pips  (video = 2 pips)
input bool     InpUseStructureStop = false;  // Put SL just beyond the sweep extreme instead of fixed pips
input double   InpStopBufferPips   = 1.0;    // Extra buffer beyond sweep extreme (structure stop)
input double   InpRewardRatio      = 10.0;   // Take-profit target = Reward : Risk multiple

input group             "===== Visuals ====="
input bool     InpShowABCD         = true;   // Draw A / B / C / D labels
input bool     InpShowLevels       = true;   // Draw Entry / SL / TP lines of the latest setup
input bool     InpShowSRLine       = true;   // Draw the swept Support/Resistance level
input bool     InpShowRRBoxes      = true;   // Draw green reward box / red risk box (like the video)
input int      InpProjectBars      = 16;     // How far to project levels/boxes to the right (bars)
input color    InpBuyColor         = clrLime;       // Buy arrow colour
input color    InpSellColor        = clrRed;        // Sell arrow colour
input color    InpSRColor          = clrSilver;     // Support/Resistance colour
input color    InpEntryColor       = clrDodgerBlue; // Entry line colour
input color    InpStopColor        = clrFireBrick;  // Stop-loss colour
input color    InpTPColor          = clrSeaGreen;    // Take-profit colour
input color    InpRewardBoxColor   = clrMediumSeaGreen; // Reward box fill
input color    InpRiskBoxColor     = clrFireBrick;   // Risk box fill
input color    InpLabelColor       = clrDimGray;     // A-B-C-D label colour

input group             "===== Alerts ====="
input bool     InpAlertPopup       = true;   // Pop-up alert on new signal
input bool     InpAlertPush        = false;  // Push notification (MetaTrader mobile)
input bool     InpAlertEmail       = false;  // E-mail alert
input bool     InpAlertSound       = false;  // Play a sound
input string   InpSoundFile        = "alert.wav";

//+------------------------------------------------------------------+
//| Globals                                                          |
//+------------------------------------------------------------------+
double   BuyBuffer[];
double   SellBuffer[];

double   g_pip          = 0.0;      // value of one pip for this symbol
string   g_prefix       = "SE_";    // chart-object name prefix
int      g_lastSignalBar= -1;       // index of the most recently DRAWN setup
datetime g_lastBuyAlert = 0;        // de-dupe for buy alerts
datetime g_lastSellAlert= 0;        // de-dupe for sell alerts

//+------------------------------------------------------------------+
//| Value of one pip for the current symbol                          |
//|  - 5 / 3-digit FX and 2-digit metals (XAUUSD) -> 10 points       |
//|  - 4 / 2-digit "classic" FX                   -> 1 point         |
//|  For XAUUSD (Digits=2, Point=0.01) this returns 0.10, so         |
//|  InpStopPips = 2.0 -> 0.20 price  (matches the video exactly).    |
//+------------------------------------------------------------------+
double PipSize()
  {
   int    digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double point  = _Point;
   if(digits == 3 || digits == 5)
      return(10.0 * point);
   if(digits == 2)                 // 2-digit gold / metals: 1 pip = 0.10
      return(10.0 * point);
   return(point);                  // 4-digit FX and everything else
  }

//+------------------------------------------------------------------+
//| OnInit                                                           |
//+------------------------------------------------------------------+
int OnInit()
  {
   SetIndexBuffer(0, BuyBuffer,  INDICATOR_DATA);
   SetIndexBuffer(1, SellBuffer, INDICATOR_DATA);

   PlotIndexSetInteger(0, PLOT_DRAW_BEGIN, InpSwingLength);
   PlotIndexSetInteger(1, PLOT_DRAW_BEGIN, InpSwingLength);
   PlotIndexSetInteger(0, PLOT_ARROW, 233);        // up arrow
   PlotIndexSetInteger(1, PLOT_ARROW, 234);        // down arrow
   PlotIndexSetInteger(0, PLOT_ARROW_SHIFT, 12);   // buy arrow below the bar
   PlotIndexSetInteger(1, PLOT_ARROW_SHIFT, -12);  // sell arrow above the bar
   PlotIndexSetInteger(0, PLOT_LINE_COLOR, InpBuyColor);
   PlotIndexSetInteger(1, PLOT_LINE_COLOR, InpSellColor);
   PlotIndexSetDouble(0, PLOT_EMPTY_VALUE, EMPTY_VALUE);
   PlotIndexSetDouble(1, PLOT_EMPTY_VALUE, EMPTY_VALUE);

   g_pip = PipSize();
   if(g_pip <= 0.0)
      g_pip = _Point;

   IndicatorSetString(INDICATOR_SHORTNAME,
                      StringFormat("Sniper Entry (FalseBreakout)  SL=%.1f pip  RR=1:%.0f",
                                   InpStopPips, InpRewardRatio));

   ObjectsDeleteAll(0, g_prefix);
   g_lastSignalBar = -1;
   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
//| OnDeinit                                                         |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
  {
   ObjectsDeleteAll(0, g_prefix);
   ChartRedraw();
  }

//+------------------------------------------------------------------+
//| Pivot helpers (work on non-series arrays: index 0 = oldest bar)  |
//+------------------------------------------------------------------+
bool IsPivotHigh(const int i, const int len, const int rt, const double &high[])
  {
   if(i - len < 0 || i + len > rt - 1)
      return(false);
   double v = high[i];
   for(int k = i - len; k <= i + len; k++)
     {
      if(k == i)
         continue;
      if(high[k] >= v)             // strict maximum (ties rejected -> cleaner pivots)
         return(false);
     }
   return(true);
  }

bool IsPivotLow(const int i, const int len, const int rt, const double &low[])
  {
   if(i - len < 0 || i + len > rt - 1)
      return(false);
   double v = low[i];
   for(int k = i - len; k <= i + len; k++)
     {
      if(k == i)
         continue;
      if(low[k] <= v)              // strict minimum
         return(false);
     }
   return(true);
  }

//+------------------------------------------------------------------+
//| Detect a BUY (bullish) false-breakout at CLOSED bar i            |
//|  Fills: aIdx,bIdx,cIdx,dIdx and the support level                |
//+------------------------------------------------------------------+
bool DetectBuy(const int i, const int rt,
               const double &open[], const double &high[],
               const double &low[],  const double &close[],
               int &aIdx, int &bIdx, int &cIdx, int &dIdx, double &support)
  {
   int L  = InpSwingLength;
   int lo = MathMax(L, i - InpLookbackPivots);

   //--- C : most recent confirmed swing HIGH before i (the lower high).
   //    Anchoring on C (not on the nearest low) is essential: the sweep low D
   //    is itself a pivot low, so "nearest pivot low" would wrongly pick D.
   cIdx = -1;
   for(int j = i - 1; j >= lo; j--)
      if(IsPivotHigh(j, L, rt, high))
        { cIdx = j; break; }
   if(cIdx < 0)
      return(false);

   //--- B : most recent confirmed swing LOW before C  (= the support level)
   bIdx = -1;
   for(int j = cIdx - 1; j >= lo; j--)
      if(IsPivotLow(j, L, rt, low))
        { bIdx = j; break; }
   if(bIdx < 0)
      return(false);
   support = low[bIdx];

   //--- D : lowest low AFTER C up to i -> must pierce BELOW support (the sweep)
   dIdx = -1;
   double sweepLow = DBL_MAX;
   for(int j = cIdx + 1; j <= i; j++)
      if(low[j] < sweepLow)
        { sweepLow = low[j]; dIdx = j; }
   if(dIdx < 0 || sweepLow >= support)
      return(false);                               // no false breakout below support

   //--- the reclaim must be recent relative to the sweep extreme
   if(i - dIdx > InpReclaimBars)
      return(false);

   //--- reclaim : the current closed bar closes back ABOVE support, bullish
   if(close[i] <= support)
      return(false);
   if(close[i] <= open[i])                          // confirm with a bullish close
      return(false);

   //--- optional: the sweep bar had to actually CLOSE below the level first
   if(InpRequireSweepClose && close[dIdx] >= support)
      return(false);

   //--- one signal per sweep: bar i must be the FIRST bullish reclaim since D.
   //    (purely data-driven, so re-processing a bar never duplicates a signal)
   for(int j = dIdx; j < i; j++)
      if(close[j] > support && close[j] > open[j])
         return(false);

   //--- A-B-C-D context (optional): A = swing HIGH before B, higher than C
   aIdx = -1;
   if(InpRequireABCD)
     {
      for(int j = bIdx - 1; j >= lo; j--)
         if(IsPivotHigh(j, L, rt, high))
           { aIdx = j; break; }
      if(aIdx < 0)
         return(false);
      if(high[cIdx] >= high[aIdx])                  // C must be a LOWER high than A
         return(false);
     }
   return(true);
  }

//+------------------------------------------------------------------+
//| Detect a SELL (bearish) false-breakout at CLOSED bar i (mirror)  |
//+------------------------------------------------------------------+
bool DetectSell(const int i, const int rt,
                const double &open[], const double &high[],
                const double &low[],  const double &close[],
                int &aIdx, int &bIdx, int &cIdx, int &dIdx, double &resistance)
  {
   int L  = InpSwingLength;
   int lo = MathMax(L, i - InpLookbackPivots);

   //--- C : most recent confirmed swing LOW before i (the higher low)
   cIdx = -1;
   for(int j = i - 1; j >= lo; j--)
      if(IsPivotLow(j, L, rt, low))
        { cIdx = j; break; }
   if(cIdx < 0)
      return(false);

   //--- B : most recent confirmed swing HIGH before C  (= the resistance)
   bIdx = -1;
   for(int j = cIdx - 1; j >= lo; j--)
      if(IsPivotHigh(j, L, rt, high))
        { bIdx = j; break; }
   if(bIdx < 0)
      return(false);
   resistance = high[bIdx];

   //--- D : highest high AFTER C up to i -> must pierce ABOVE resistance
   dIdx = -1;
   double sweepHigh = -DBL_MAX;
   for(int j = cIdx + 1; j <= i; j++)
      if(high[j] > sweepHigh)
        { sweepHigh = high[j]; dIdx = j; }
   if(dIdx < 0 || sweepHigh <= resistance)
      return(false);

   if(i - dIdx > InpReclaimBars)
      return(false);

   //--- reclaim : current closed bar closes back BELOW resistance, bearish
   if(close[i] >= resistance)
      return(false);
   if(close[i] >= open[i])                          // confirm with a bearish close
      return(false);

   if(InpRequireSweepClose && close[dIdx] <= resistance)
      return(false);

   //--- one signal per sweep: first bearish reclaim since D
   for(int j = dIdx; j < i; j++)
      if(close[j] < resistance && close[j] < open[j])
         return(false);

   //--- A-B-C-D context (optional): A = swing LOW before B, lower than C
   aIdx = -1;
   if(InpRequireABCD)
     {
      for(int j = bIdx - 1; j >= lo; j--)
         if(IsPivotLow(j, L, rt, low))
           { aIdx = j; break; }
      if(aIdx < 0)
         return(false);
      if(low[cIdx] <= low[aIdx])                    // C must be a HIGHER low than A
         return(false);
     }
   return(true);
  }

//+------------------------------------------------------------------+
//| Object drawing helpers                                           |
//+------------------------------------------------------------------+
void DrawSegment(const string name, const datetime t1, const double p1,
                 const datetime t2, const double p2, const color clr,
                 const int style, const int width)
  {
   if(ObjectFind(0, name) < 0)
      ObjectCreate(0, name, OBJ_TREND, 0, t1, p1, t2, p2);
   else
     {
      ObjectMove(0, name, 0, t1, p1);
      ObjectMove(0, name, 1, t2, p2);
     }
   ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(0, name, OBJPROP_STYLE, style);
   ObjectSetInteger(0, name, OBJPROP_WIDTH, width);
   ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT, false);
   ObjectSetInteger(0, name, OBJPROP_BACK, false);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
  }

void DrawBox(const string name, const datetime t1, const double p1,
             const datetime t2, const double p2, const color clr)
  {
   if(ObjectFind(0, name) < 0)
      ObjectCreate(0, name, OBJ_RECTANGLE, 0, t1, p1, t2, p2);
   else
     {
      ObjectMove(0, name, 0, t1, p1);
      ObjectMove(0, name, 1, t2, p2);
     }
   ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(0, name, OBJPROP_FILL, true);
   ObjectSetInteger(0, name, OBJPROP_BACK, true);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
  }

void DrawText(const string name, const datetime t, const double p,
              const string txt, const color clr, const int anchor)
  {
   if(ObjectFind(0, name) < 0)
      ObjectCreate(0, name, OBJ_TEXT, 0, t, p);
   else
      ObjectMove(0, name, 0, t, p);
   ObjectSetString(0, name, OBJPROP_TEXT, txt);
   ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, 11);
   ObjectSetString(0, name, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, name, OBJPROP_ANCHOR, anchor);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
  }

//+------------------------------------------------------------------+
//| Draw the full annotated setup for the latest signal              |
//+------------------------------------------------------------------+
void DrawSetup(const bool isBuy, const int i, const datetime &time[],
               const double &high[], const double &low[],
               const int aIdx, const int bIdx, const int cIdx, const int dIdx,
               const double level, const double entry,
               const double sl, const double tp)
  {
   //--- wipe the previous setup so only the current one is shown
   ObjectsDeleteAll(0, g_prefix + "SET_");

   datetime tEnd = time[i] + (datetime)((long)InpProjectBars * PeriodSeconds(_Period));
   string   pf   = g_prefix + "SET_";

   //--- swept Support / Resistance level
   if(InpShowSRLine && bIdx >= 0)
      DrawSegment(pf + "LEVEL", time[bIdx], level, tEnd, level,
                  InpSRColor, STYLE_SOLID, 1);

   //--- A-B-C-D labels
   if(InpShowABCD && InpRequireABCD && aIdx >= 0 && cIdx >= 0)
     {
      if(isBuy)
        {
         DrawText(pf + "A", time[aIdx], high[aIdx] + 1.0 * g_pip, "A", InpLabelColor, ANCHOR_LOWER);
         DrawText(pf + "B", time[bIdx], low[bIdx]  - 1.0 * g_pip, "B", InpLabelColor, ANCHOR_UPPER);
         DrawText(pf + "C", time[cIdx], high[cIdx] + 1.0 * g_pip, "C", InpLabelColor, ANCHOR_LOWER);
         DrawText(pf + "D", time[dIdx], low[dIdx]  - 1.0 * g_pip, "D", InpLabelColor, ANCHOR_UPPER);
        }
      else
        {
         DrawText(pf + "A", time[aIdx], low[aIdx]  - 1.0 * g_pip, "A", InpLabelColor, ANCHOR_UPPER);
         DrawText(pf + "B", time[bIdx], high[bIdx] + 1.0 * g_pip, "B", InpLabelColor, ANCHOR_LOWER);
         DrawText(pf + "C", time[cIdx], low[cIdx]  - 1.0 * g_pip, "C", InpLabelColor, ANCHOR_UPPER);
         DrawText(pf + "D", time[dIdx], high[dIdx] + 1.0 * g_pip, "D", InpLabelColor, ANCHOR_LOWER);
        }
     }

   //--- Entry / SL / TP lines
   if(InpShowLevels)
     {
      DrawSegment(pf + "ENTRY", time[i], entry, tEnd, entry, InpEntryColor, STYLE_SOLID, 2);
      DrawSegment(pf + "SL",    time[i], sl,    tEnd, sl,    InpStopColor,  STYLE_DASHDOT, 1);
      DrawSegment(pf + "TP",    time[i], tp,    tEnd, tp,    InpTPColor,    STYLE_DASHDOT, 1);
      DrawText(pf + "ENTRY_T", tEnd, entry, " Entry " + DoubleToString(entry, _Digits),
               InpEntryColor, ANCHOR_LEFT);
      DrawText(pf + "SL_T",    tEnd, sl, " SL " + DoubleToString(sl, _Digits),
               InpStopColor, ANCHOR_LEFT);
      DrawText(pf + "TP_T",    tEnd, tp, " TP " + DoubleToString(tp, _Digits),
               InpTPColor, ANCHOR_LEFT);
     }

   //--- Reward box (green, entry->TP) and Risk box (red, entry->SL), like the video
   if(InpShowRRBoxes)
     {
      datetime tBox1 = time[i] + (datetime)((long)(InpProjectBars / 2) * PeriodSeconds(_Period));
      DrawBox(pf + "REWARD", tBox1, entry, tEnd, tp, InpRewardBoxColor);
      DrawBox(pf + "RISK",   tBox1, entry, tEnd, sl, InpRiskBoxColor);
     }
  }

//+------------------------------------------------------------------+
//| Fire alerts                                                      |
//+------------------------------------------------------------------+
void FireAlert(const bool isBuy, const double entry, const double sl, const double tp)
  {
   string dir = isBuy ? "BUY" : "SELL";
   string msg = StringFormat("%s  SNIPER %s (false-breakout reclaim)  Entry %s  SL %s  TP %s",
                             _Symbol, dir,
                             DoubleToString(entry, _Digits),
                             DoubleToString(sl, _Digits),
                             DoubleToString(tp, _Digits));
   if(InpAlertPopup)
      Alert(msg);
   if(InpAlertPush)
      SendNotification(msg);
   if(InpAlertEmail)
      SendMail("Sniper Entry signal: " + _Symbol, msg);
   if(InpAlertSound)
      PlaySound(InpSoundFile);
  }

//+------------------------------------------------------------------+
//| Build entry / SL / TP for a detected signal                      |
//+------------------------------------------------------------------+
void BuildLevels(const bool isBuy, const double closeI, const double sweepExtreme,
                 double &entry, double &sl, double &tp)
  {
   entry = closeI;                                  // reclaim close ~ Buy/Sell-Stop fill
   double risk;
   if(isBuy)
     {
      if(InpUseStructureStop)
         sl = sweepExtreme - InpStopBufferPips * g_pip;
      else
         sl = entry - InpStopPips * g_pip;
      risk = entry - sl;
      tp   = entry + risk * InpRewardRatio;
     }
   else
     {
      if(InpUseStructureStop)
         sl = sweepExtreme + InpStopBufferPips * g_pip;
      else
         sl = entry + InpStopPips * g_pip;
      risk = sl - entry;
      tp   = entry - risk * InpRewardRatio;
     }
  }

//+------------------------------------------------------------------+
//| OnCalculate                                                      |
//+------------------------------------------------------------------+
int OnCalculate(const int rates_total,
                const int prev_calculated,
                const datetime &time[],
                const double &open[],
                const double &high[],
                const double &low[],
                const double &close[],
                const long &tick_volume[],
                const long &volume[],
                const int &spread[])
  {
   if(rates_total < InpSwingLength * 2 + 5)
      return(rates_total);

   //--- force plain (non-series) indexing: index 0 = oldest bar.
   //    This makes the pivot/sweep logic below unambiguous regardless
   //    of how the terminal hands us the arrays.
   ArraySetAsSeries(time,  false);
   ArraySetAsSeries(open,  false);
   ArraySetAsSeries(high,  false);
   ArraySetAsSeries(low,   false);
   ArraySetAsSeries(close, false);
   ArraySetAsSeries(BuyBuffer,  false);
   ArraySetAsSeries(SellBuffer, false);

   int firstValid = InpSwingLength + 1;
   int start;
   if(prev_calculated == 0)
     {
      ArrayInitialize(BuyBuffer,  EMPTY_VALUE);
      ArrayInitialize(SellBuffer, EMPTY_VALUE);
      ObjectsDeleteAll(0, g_prefix);
      g_lastSignalBar = -1;
      start = firstValid;
     }
   else
      start = MathMax(firstValid, prev_calculated - 2);

   //--- evaluate only CLOSED bars: last closed bar = rates_total-2
   int lastClosed = rates_total - 2;

   for(int i = start; i <= lastClosed; i++)
     {
      BuyBuffer[i]  = EMPTY_VALUE;
      SellBuffer[i] = EMPTY_VALUE;

      int    aIdx, bIdx, cIdx, dIdx;
      double level, entry, sl, tp;
      //--- only the freshest bar alerts, and never during the initial backfill
      bool   allowAlert = (i == lastClosed && prev_calculated > 0);

      //--- BUY --------------------------------------------------------
      if(InpDirection == DIR_BOTH || InpDirection == DIR_BUY)
        {
         if(DetectBuy(i, rates_total, open, high, low, close,
                      aIdx, bIdx, cIdx, dIdx, level))
           {
            BuyBuffer[i] = low[i];
            double sweepLow = low[dIdx];
            BuildLevels(true, close[i], sweepLow, entry, sl, tp);

            if(i >= g_lastSignalBar)
              {
               DrawSetup(true, i, time, high, low, aIdx, bIdx, cIdx, dIdx,
                         level, entry, sl, tp);
               DrawText(g_prefix + "SET_TAG", time[i], high[i] + 3.0 * g_pip,
                        "SNIPER BUY", InpBuyColor, ANCHOR_LOWER);
               g_lastSignalBar = i;
              }
            if(allowAlert && time[i] != g_lastBuyAlert)
              {
               FireAlert(true, entry, sl, tp);
               g_lastBuyAlert = time[i];
              }
            continue;
           }
        }

      //--- SELL -------------------------------------------------------
      if(InpDirection == DIR_BOTH || InpDirection == DIR_SELL)
        {
         if(DetectSell(i, rates_total, open, high, low, close,
                       aIdx, bIdx, cIdx, dIdx, level))
           {
            SellBuffer[i] = high[i];
            double sweepHigh = high[dIdx];
            BuildLevels(false, close[i], sweepHigh, entry, sl, tp);

            if(i >= g_lastSignalBar)
              {
               DrawSetup(false, i, time, high, low, aIdx, bIdx, cIdx, dIdx,
                         level, entry, sl, tp);
               DrawText(g_prefix + "SET_TAG", time[i], low[i] - 3.0 * g_pip,
                        "SNIPER SELL", InpSellColor, ANCHOR_UPPER);
               g_lastSignalBar = i;
              }
            if(allowAlert && time[i] != g_lastSellAlert)
              {
               FireAlert(false, entry, sl, tp);
               g_lastSellAlert = time[i];
              }
           }
        }
     }

   //--- never draw on the still-forming bar
   if(rates_total >= 1)
     {
      BuyBuffer[rates_total - 1]  = EMPTY_VALUE;
      SellBuffer[rates_total - 1] = EMPTY_VALUE;
     }

   return(rates_total);
  }
//+------------------------------------------------------------------+
