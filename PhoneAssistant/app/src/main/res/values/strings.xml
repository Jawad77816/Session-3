    <!-- Onboarding permission cards -->
    <string name="perm_accessibility_title">1. App Automation (Accessibility)</string>
    <string name="perm_accessibility_desc">Required to auto-send WhatsApp / WhatsApp Business messages by tapping Send for you. Turn on “Phone Assistant — App Automation”.</string>
    <string name="perm_notif_title">2. Notification access</string>
    <string name="perm_notif_desc">Lets the assistant read notifications from all apps. Optional, but part of the cross-app awareness.</string>
    <string name="perm_smscontacts_title">3. SMS &amp; Contacts</string>
    <string name="perm_smscontacts_desc">Send SMS directly and look up a contact’s number by name.</string>
    <string name="perm_postnotif_title">4. Show notifications</string>
    <string name="perm_postnotif_desc">Allow status notifications so you see when a scheduled task ran.</string>
    <string name="perm_exact_title">5. Exact alarms</string>
    <string name="perm_exact_desc">Required so tasks fire at the exact minute you choose, even in Doze.</string>
    <string name="perm_battery_title">6. Ignore battery optimisation</string>
    <string name="perm_battery_desc">Keeps scheduled tasks reliable when the phone is idle.</string>
