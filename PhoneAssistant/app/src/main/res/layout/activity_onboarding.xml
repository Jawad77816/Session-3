<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
        app:title="@string/setup_title"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/cardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/setup_intro"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <!-- 1. Accessibility -->
            <com.google.android.material.card.MaterialCardView
                style="@style/PermCard">
                <LinearLayout style="@style/PermCardInner">
                    <TextView style="@style/PermTitle" android:text="@string/perm_accessibility_title" />
                    <TextView style="@style/PermDesc" android:text="@string/perm_accessibility_desc" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccessibility"
                        style="@style/PermButton"
                        android:text="@string/open_settings" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Notification access -->
            <com.google.android.material.card.MaterialCardView
                style="@style/PermCard">
                <LinearLayout style="@style/PermCardInner">
                    <TextView style="@style/PermTitle" android:text="@string/perm_notif_title" />
                    <TextView style="@style/PermDesc" android:text="@string/perm_notif_desc" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNotifAccess"
                        style="@style/PermButton"
                        android:text="@string/open_settings" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. SMS & Contacts -->
            <com.google.android.material.card.MaterialCardView
                style="@style/PermCard">
                <LinearLayout style="@style/PermCardInner">
                    <TextView style="@style/PermTitle" android:text="@string/perm_smscontacts_title" />
                    <TextView style="@style/PermDesc" android:text="@string/perm_smscontacts_desc" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSmsContacts"
                        style="@style/PermButton"
                        android:text="@string/grant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Post notifications -->
            <com.google.android.material.card.MaterialCardView
                style="@style/PermCard">
                <LinearLayout style="@style/PermCardInner">
                    <TextView style="@style/PermTitle" android:text="@string/perm_postnotif_title" />
                    <TextView style="@style/PermDesc" android:text="@string/perm_postnotif_desc" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPostNotif"
                        style="@style/PermButton"
                        android:text="@string/grant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Exact alarms -->
            <com.google.android.material.card.MaterialCardView
                style="@style/PermCard">
                <LinearLayout style="@style/PermCardInner">
                    <TextView style="@style/PermTitle" android:text="@string/perm_exact_title" />
                    <TextView style="@style/PermDesc" android:text="@string/perm_exact_desc" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExactAlarm"
                        style="@style/PermButton"
                        android:text="@string/open_settings" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6. Battery -->
            <com.google.android.material.card.MaterialCardView
                style="@style/PermCard">
                <LinearLayout style="@style/PermCardInner">
                    <TextView style="@style/PermTitle" android:text="@string/perm_battery_title" />
                    <TextView style="@style/PermDesc" android:text="@string/perm_battery_desc" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBattery"
                        style="@style/PermButton"
                        android:text="@string/open_settings" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/done" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
