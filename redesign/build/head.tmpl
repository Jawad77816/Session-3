<style>
/* ============================================================================
   AESTHETICS MED & WELLNESS BY G — SHARED DESIGN SYSTEM
   COLOR SCHEME = tokens in :root. Placeholder warm blush/plum/gold palette;
   edit ONLY :root to match your existing brand. Identical across all 5 pages.
   ========================================================================== */
@font-face{font-family:"Gloock";src:url(data:font/ttf;base64,__GLOOCK_B64__) format("truetype");font-weight:400;font-style:normal;font-display:swap}

:root{
  --bg:#FAF6F1; --bg-2:#F4EBE2; --surface:#FFFFFF;
  --blush:#EAD8D1; --rose:#CE9A92; --rose-deep:#B87E77;
  --plum:#5E3B47; --plum-deep:#43272F; --plum-soft:#7A5460;
  --gold:#B08B4F; --gold-soft:#D9C39A;
  --ink:#2A2320; --ink-2:#584D47; --muted:#8A7E76;
  --line:#E7D8CD; --line-2:#EFE4D8;
  --display:"Gloock","Hoefler Text","Georgia","Times New Roman",serif;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,"Noto Sans",sans-serif;
  --maxw:1200px; --radius:18px; --radius-sm:12px; --radius-lg:28px;
  --shadow-sm:0 1px 2px rgba(42,35,32,.04),0 2px 8px rgba(42,35,32,.05);
  --shadow:0 10px 30px -12px rgba(67,39,47,.22),0 4px 12px -6px rgba(67,39,47,.14);
  --shadow-lg:0 30px 60px -20px rgba(67,39,47,.34);
  --ease:cubic-bezier(.22,.61,.36,1);
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;overflow-x:hidden}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--bg);color:var(--ink-2);font-family:var(--sans);font-size:1.0625rem;line-height:1.65;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;overflow-x:hidden}
h1,h2,h3,h4{color:var(--ink);font-weight:400;line-height:1.08;margin:0 0 .4em;letter-spacing:-.01em}
h1,h2,h3{font-family:var(--display)}
p{margin:0 0 1rem}
a{color:var(--plum);text-decoration:none}
img{max-width:100%;display:block}
::selection{background:var(--rose);color:#fff}
:focus-visible{outline:3px solid var(--rose);outline-offset:3px}

.wrap{max-width:var(--maxw);margin-inline:auto;padding-inline:clamp(1.15rem,4vw,2.5rem)}
.section{padding-block:clamp(3.5rem,8vw,7rem)}
.section.-sm{padding-block:clamp(2.5rem,5vw,4rem)}
.eyebrow{font-size:.72rem;text-transform:uppercase;letter-spacing:.2em;font-weight:700;color:var(--gold);display:inline-flex;align-items:center;gap:.6rem;margin:0 0 1rem}
.eyebrow::before{content:"";width:26px;height:1px;background:var(--gold);opacity:.7}
.eyebrow.-center{justify-content:center}
.eyebrow.-center::after{content:"";width:26px;height:1px;background:var(--gold);opacity:.7}
.lead{font-size:1.2rem;line-height:1.6;color:var(--ink-2);max-width:62ch}
.display-xl{font-family:var(--display);font-weight:400;color:var(--ink);font-size:clamp(2.6rem,6vw,4.6rem);line-height:1.03;letter-spacing:-.02em}
.h2{font-size:clamp(1.9rem,3.8vw,3rem)}
.h3{font-size:clamp(1.4rem,2.4vw,1.9rem)}
.center{text-align:center}.mx-auto{margin-inline:auto}
.muted{color:var(--muted)}.plum{color:var(--plum)}.accent{color:var(--gold)}
.serif-em{font-family:var(--display);font-style:normal}
.maxch{max-width:60ch}

.skip{position:absolute;left:-999px;top:0;background:var(--plum);color:#fff;padding:.75rem 1.25rem;border-radius:0 0 10px 0;z-index:200}
.skip:focus{left:0}

.btn{--b:var(--plum);--f:#fff;display:inline-flex;align-items:center;justify-content:center;gap:.55rem;font-family:var(--sans);font-size:.95rem;font-weight:600;letter-spacing:.01em;padding:.95rem 1.6rem;border-radius:100px;border:1.5px solid var(--b);background:var(--b);color:var(--f);cursor:pointer;transition:transform .25s var(--ease),box-shadow .25s var(--ease),background .25s var(--ease),color .2s;min-height:48px;text-align:center}
.btn:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.btn.-deep{--b:var(--plum-deep)}
.btn.-ghost{background:transparent;color:var(--plum);border-color:var(--line)}
.btn.-ghost:hover{border-color:var(--plum);background:#fff}
.btn.-gold{--b:var(--gold);--f:#fff}
.btn.-light{--b:#fff;--f:var(--plum);border-color:#fff}
.btn.-lg{padding:1.1rem 2rem;font-size:1.02rem}
.btn .ic{width:18px;height:18px}
.link-arrow{display:inline-flex;align-items:center;gap:.45rem;font-weight:600;color:var(--plum);border-bottom:1.5px solid transparent;padding-bottom:2px;transition:gap .25s var(--ease),border-color .25s}
.link-arrow:hover{gap:.75rem;border-color:var(--rose)}

/* Page hero (interior pages) */
.page-hero{position:relative;overflow:hidden;background:var(--bg)}
.page-hero::before{content:"";position:absolute;inset:0;z-index:0;background:radial-gradient(60% 60% at 88% 12%,rgba(206,154,146,.28),transparent 60%),radial-gradient(50% 50% at 10% 100%,rgba(176,139,79,.12),transparent 60%)}
.page-hero .wrap{position:relative;z-index:1;padding-block:clamp(3rem,6vw,5.5rem)}
.page-hero .ph-inner{max-width:760px}
.breadcrumb{font-size:.82rem;color:var(--muted);margin-bottom:1.5rem;display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}
.breadcrumb a{color:var(--muted)}.breadcrumb a:hover{color:var(--plum)}
.breadcrumb .sep{opacity:.5}

/* Generic cards / chips / grids */
.card{background:var(--surface);border:1px solid var(--line-2);border-radius:var(--radius);padding:1.75rem}
.chip{background:var(--surface);border:1px solid var(--line);border-radius:100px;padding:.45rem 1rem;font-size:.85rem;font-weight:600;color:var(--plum);display:inline-flex;align-items:center;gap:.5rem}
.grid{display:grid;gap:1.25rem}
.g-2{grid-template-columns:repeat(2,1fr)}
.g-3{grid-template-columns:repeat(3,1fr)}
.g-4{grid-template-columns:repeat(4,1fr)}
@media (max-width:900px){.g-3,.g-4{grid-template-columns:repeat(2,1fr)}}
@media (max-width:600px){.g-2,.g-3,.g-4{grid-template-columns:1fr}}

/* Forms */
.field{margin-bottom:1.1rem}
.field label{display:block;font-size:.85rem;font-weight:600;color:var(--ink);margin-bottom:.4rem}
.field .req{color:var(--rose-deep)}
.input,.textarea,.select{width:100%;font-family:var(--sans);font-size:1rem;color:var(--ink);background:var(--surface);border:1.5px solid var(--line);border-radius:12px;padding:.85rem 1rem;transition:border-color .2s,box-shadow .2s}
.input:focus,.textarea:focus,.select:focus{outline:none;border-color:var(--plum-soft);box-shadow:0 0 0 4px rgba(94,59,71,.1)}
.textarea{min-height:130px;resize:vertical}
.help{font-size:.8rem;color:var(--muted);margin-top:.35rem}

/* Reveal */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s var(--ease),transform .7s var(--ease)}
.reveal.-in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}}

/* ---------------- Top bar / Header / Mobile menu ---------------- */
.topbar{background:var(--plum-deep);color:#F3E8DE;font-size:.82rem}
.topbar .wrap{display:flex;align-items:center;justify-content:center;gap:1.5rem;padding-block:.55rem;flex-wrap:wrap;text-align:center}
.topbar a{color:#fff;font-weight:600}
.topbar .dot{width:4px;height:4px;border-radius:50%;background:var(--rose);display:inline-block}
@media (max-width:640px){.topbar .tb-hide{display:none}}
.site-header{position:sticky;top:0;z-index:100;background:rgba(250,246,241,.82);backdrop-filter:saturate(1.4) blur(14px);border-bottom:1px solid transparent;transition:border-color .3s,box-shadow .3s,background .3s}
.site-header.-scrolled{border-color:var(--line);box-shadow:var(--shadow-sm);background:rgba(250,246,241,.95)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-block:.9rem}
.brand{display:flex;align-items:center;gap:.7rem;line-height:1}
.brand-mark{width:44px;height:44px;flex:none}
.brand-txt{display:flex;flex-direction:column}
.brand-name{font-family:var(--display);font-size:1.18rem;color:var(--ink);letter-spacing:.01em}
.brand-sub{font-size:.62rem;text-transform:uppercase;letter-spacing:.24em;color:var(--gold);font-weight:700}
.nav-links{display:flex;align-items:center;gap:.35rem;list-style:none;margin:0;padding:0}
.nav-links a{color:var(--ink);font-weight:500;font-size:.96rem;padding:.55rem .85rem;border-radius:8px;transition:color .2s,background .2s}
.nav-links a:hover{color:var(--plum);background:var(--bg-2)}
.nav-links a[aria-current=page]{color:var(--plum);background:var(--bg-2)}
.nav-cta{display:flex;align-items:center;gap:.6rem}
.nav-phone{display:inline-flex;align-items:center;gap:.45rem;font-weight:600;color:var(--ink);font-size:.95rem}
.nav-toggle{display:none;background:none;border:1.5px solid var(--line);border-radius:10px;width:46px;height:46px;cursor:pointer;align-items:center;justify-content:center;color:var(--plum)}
.nav-toggle svg{width:22px;height:22px}
@media (max-width:960px){.nav-links,.nav-cta{display:none}.nav-toggle{display:inline-flex}}
.mobile-menu{position:fixed;inset:0 0 0 auto;width:min(88vw,360px);background:var(--bg);transform:translateX(100%);transition:transform .4s var(--ease);z-index:150;box-shadow:var(--shadow-lg);padding:1.5rem;display:flex;flex-direction:column;gap:.25rem;overflow-y:auto}
.mobile-menu.-open{transform:translateX(0)}
.mobile-menu a{color:var(--ink);font-size:1.15rem;padding:.9rem .5rem;border-bottom:1px solid var(--line-2);font-weight:500}
.mobile-menu .mm-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem}
.mm-close{background:none;border:none;cursor:pointer;color:var(--plum);width:44px;height:44px}
.scrim{position:fixed;inset:0;background:rgba(43,26,32,.4);opacity:0;visibility:hidden;transition:.3s;z-index:140}
.scrim.-on{opacity:1;visibility:visible}

/* ---------------- Footer ---------------- */
.footer{background:#211217;color:#C9B6AD;font-size:.92rem}
.footer .wrap{padding-block:clamp(3rem,5vw,4.5rem)}
.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.2fr;gap:2rem}
@media (max-width:860px){.foot-grid{grid-template-columns:1fr 1fr}}
@media (max-width:520px){.foot-grid{grid-template-columns:1fr}}
.footer h4{color:#fff;font-family:var(--sans);font-weight:700;font-size:.8rem;text-transform:uppercase;letter-spacing:.14em;margin-bottom:1.1rem}
.footer a{color:#C9B6AD;display:block;padding:.3rem 0;transition:color .2s}
.footer a:hover{color:#fff}
.foot-brand .brand-name{color:#fff}
.foot-brand p{max-width:34ch;margin-top:1rem;font-size:.9rem;color:#B39A91}
.foot-social{display:flex;gap:.6rem;margin-top:1.25rem}
.foot-social a{width:40px;height:40px;border:1px solid rgba(255,255,255,.16);border-radius:10px;display:flex;align-items:center;justify-content:center;padding:0}
.foot-social svg{width:19px;height:19px}
.foot-bottom{border-top:1px solid rgba(255,255,255,.1);margin-top:2.5rem;padding-top:1.5rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.82rem;color:#9C837A}
.foot-bottom a{display:inline;color:#9C837A}

/* Final CTA band (shared) */
.cta-band{background:var(--plum-deep);color:#fff;position:relative;overflow:hidden}
.cta-band::before{content:"";position:absolute;inset:0;background:radial-gradient(40% 80% at 85% 20%,rgba(206,154,146,.3),transparent 60%),radial-gradient(40% 80% at 10% 90%,rgba(176,139,79,.22),transparent 60%)}
.cta-band .wrap{position:relative;text-align:center;padding-block:clamp(3.5rem,7vw,6rem)}
.cta-band h2{color:#fff;margin-bottom:1rem}
.cta-band p{color:#EAD9D0;max-width:52ch;margin:0 auto 2rem}
.cta-actions{display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap}

/* page-specific styles injected here */
__PAGECSS__
</style>
